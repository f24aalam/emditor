{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "emditor",
  "mainBinaryName": "emditor-app",
  "version": "0.1.0",
  "identifier": "com.emditor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:launchers",
    "beforeBundleCommand": "node scripts/build-launchers.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "emditor",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: http: data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
